# Environment Configuration for Resilience Rewired
# Copy to .env and populate credentials if utilizing optional cloud integrations

# Google Gemini API Key (Optional: for dynamic executive AI Q&A narrative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Snowflake Data Warehouse Credentials (Optional: enterprise mode)
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RESILIENCE_REWIRED
SNOWFLAKE_SCHEMA=MART
